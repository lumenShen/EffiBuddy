# Copy these values into your shell environment (or CI secrets).
# The desktop app reads them via std::env; it also accepts a local
# `deepseekAPIKey.env` file in the workspace or next to the config.
#
# Provider keys are optional when the provider is configured in
# Settings → Models (providers.json). Local endpoints such as Ollama do not
# need a key at all.
#
# Never commit a real key.

DEEPSEEK_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
ZAI_API_KEY=
BIGMODEL_API_KEY=
MOONSHOT_API_KEY=
OPENROUTER_API_KEY=
SILICONFLOW_API_KEY=

# Legacy fallback, used by the DeepSeek provider when no provider-specific key
# is configured.
# EFFIBUDDY_API_KEY=
